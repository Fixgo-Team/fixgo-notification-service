# Copy to .env and fill in. Never commit .env.
# Spring does not read .env by itself: export these variables or set them in your IDE run configuration.

APP_NOTIFICATIONS_DATABASE_URL=jdbc:mysql://localhost:3306/notification_db
APP_NOTIFICATIONS_DATABASE_USER=fixgo
APP_NOTIFICATIONS_DATABASE_PASSWORD=

# "logging" (no Firebase needed) or "fcm"
APP_NOTIFICATIONS_PUSH_SENDER=logging

# Path to the Firebase service-account JSON (only when push sender is "fcm"). Never commit that file.
APP_NOTIFICATIONS_FCM_CREDENTIALS=

# Shared secret for POST /notifications (internal service calls)
APP_NOTIFICATIONS_INTERNAL_API_KEY=

# docker-compose only
MYSQL_PORT=3306
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
